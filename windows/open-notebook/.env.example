# Copy to .env (same folder) and fill in. .env is git-ignored.

# REQUIRED. Any long random string. Encrypts the model credentials that
# Open Notebook stores in its database. Never change it after first use:
# every stored credential becomes unreadable if this key changes.
OPEN_NOTEBOOK_ENCRYPTION_KEY=replace-with-a-long-random-string

# Optional. Database login. root:root is fine while the stack is only reachable
# from this PC (the database port is bound to 127.0.0.1).
# SURREAL_USER=root
# SURREAL_PASSWORD=root
